# Identity
set from = "yyaqia@gmail.com"
set realname = ""
set use_from = yes
set envelope_from = yes

# IMAP
set imap_user = "yyaqia@gmail.com"
set imap_pass = "`secret-tool lookup service neomutt account yyaqia@gmail.com`"

set folder = "imaps://imap.gmail.com/"
set spoolfile = "+INBOX"
